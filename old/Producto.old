package com.techlab.laperfu.model;

import com.fasterxml.jackson.annotation.JsonSubTypes;
import com.fasterxml.jackson.annotation.JsonTypeInfo;
import com.fasterxml.jackson.annotation.JsonIgnore;
import com.fasterxml.jackson.annotation.JsonPropertyOrder;
import com.techlab.laperfu.exception.PrecioInvalidoException;
import com.techlab.laperfu.exception.StockInvalidoException;
import lombok.Getter;
import lombok.Setter;
import lombok.NoArgsConstructor;
import lombok.AccessLevel;

@JsonTypeInfo(
    use = JsonTypeInfo.Id.NAME, 
    include = JsonTypeInfo.As.PROPERTY, 
    property = "categoria"
)
@JsonSubTypes({
    @JsonSubTypes.Type(value = Crema.class, name = "crema"),
    @JsonSubTypes.Type(value = Perfume.class, name = "perfume"),
    @JsonSubTypes.Type(value = Shampoo.class, name = "shampoo")
})
@JsonPropertyOrder({ "id", "nombre", "precio", "stock", "categoria"})
@NoArgsConstructor(access = AccessLevel.PUBLIC) // <-- Cambiado a PUBLIC para Jackson
public abstract class Producto {

    public static Long contadorId = 0L;
    
    @Getter 
    private static int totalProductos = 0;

    @Getter 
    private Long id;
    
    @Getter @Setter 
    private String nombre;
    
    @Getter 
    private Double precio;
    
    @Getter 
    private int stock;

    // Constructor con parámetros (lo usás vos manualmente si creás objetos en duro)
    public Producto (String nombre, Double precio, int stock){
        if (precio == null || precio <= 0) {
            throw new PrecioInvalidoException("El precio debe ser mayor a cero.");
        }
        if (stock < 0) {
            throw new StockInvalidoException("El stock inicial no puede ser negativo.");
        }
        this.nombre = nombre;
        this.precio = precio;
        this.stock = stock;
        totalProductos++;
    }     

    @JsonIgnore 
    public abstract String getCategoria();
    
    public abstract void aplicarDescuento(Double porcentaje);

    // Setter para que el Service asigne el ID
    public void setId(Long id) {
        this.id = id;
    }

    public void setPrecio(Double precio) {
        if (precio == null || precio <= 0) {
            throw new PrecioInvalidoException("El nuevo precio debe ser mayor a cero.");
        }
        this.precio = precio;
    }

    public void setStock(int stock) {
        if (stock < 0) {
            throw new StockInvalidoException("El stock modificado no puede ser negativo.");
        }
        this.stock = stock;
    }

    public void mostrarDatos() {
        System.out.println("ID: " + id);
        System.out.println("Nombre: " + nombre);
        System.out.println("Precio: " + precio);
        System.out.println("Stock: " + stock);
    }
}
